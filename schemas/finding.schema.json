{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas-cdd.internal/1.0.0/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "required": [
    "finding_id",
    "case_id",
    "type",
    "severity",
    "title",
    "detail",
    "basis",
    "confidence",
    "evidence_refs",
    "status",
    "created_at",
    "created_by"
  ],
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^FND-[0-9]+-[0-9]{4}$"
    },
    "case_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "IDENTITY_MISMATCH",
        "IDENTIFIER_INCONSISTENT",
        "DOCUMENT_EXPIRED",
        "DOCUMENT_ILLEGIBLE",
        "DOCUMENT_AUTHENTICITY",
        "WRONG_SUBJECT",
        "CONTRADICTION",
        "CORPORATE_STATUS_ALERT",
        "UNRESOLVED_UBO",
        "CIRCULAR_OWNERSHIP",
        "NOMINEE_INDICATOR",
        "NO_NATURAL_PERSON",
        "SANCTIONS_HIT",
        "PEP_EXPOSURE",
        "ADVERSE_MEDIA",
        "ENFORCEMENT_ACTION",
        "UNEXPLAINED_SOURCE_OF_FUNDS",
        "ACTIVITY_INCONSISTENT",
        "INJECTION_ATTEMPT",
        "COVERAGE_GAP",
        "SCREENING_INCOMPLETE",
        "CRITIC_DEFECT"
      ]
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "detail": {
      "type": "string",
      "maxLength": 2000
    },
    "basis": {
      "enum": [
        "document",
        "registry",
        "screening",
        "inference",
        "judgment",
        "human"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EV-"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating_impact": {
      "type": "object",
      "properties": {
        "factor": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "UP",
            "DOWN",
            "NONE"
          ]
        },
        "weight_points": {
          "type": "number"
        }
      }
    },
    "status": {
      "enum": [
        "OPEN",
        "MITIGATED",
        "CLOSED",
        "QUARANTINED",
        "SUPERSEDED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "skill",
        "run_id"
      ],
      "properties": {
        "skill": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      }
    }
  }
}
