{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axiom.internal/1.0.0/bundle-manifest.schema.json",
  "title": "PolicyBundleManifest",
  "type": "object",
  "required": [
    "revision",
    "policy_version",
    "sha256",
    "opa_version",
    "entrypoints",
    "files",
    "restricted_capabilities",
    "tests",
    "status"
  ],
  "properties": {
    "revision": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer"
    },
    "built_at": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "opa_version": {
      "type": "string"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:"
      }
    },
    "source_file_count": {
      "type": "integer"
    },
    "restricted_capabilities": {
      "const": true
    },
    "denied_builtins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "bundle_path": {
      "type": "string"
    },
    "status": {
      "enum": [
        "STAGED",
        "ACTIVE",
        "SUPERSEDED",
        "REJECTED"
      ]
    },
    "activated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "activated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
