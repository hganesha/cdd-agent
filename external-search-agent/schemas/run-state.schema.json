{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.example/schemas/webis/run-state.schema.json",
  "title": "RunState",
  "description": "The checkpoint written to out/state/run_<request_id>.json after every query. Written atomically (tmp + rename); a valid file is always a complete, resumable snapshot.",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "subject",
    "query_index",
    "queries",
    "fetches",
    "passages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "webis.run-state/1"
    },
    "request_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "PARTIAL",
        "FAILED"
      ]
    },
    "query_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of leading queries already completed. Resume starts here."
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fetches": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "url -> FetchResult. A resumed run must not re-fetch, so bodies live here."
    },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "passage_id",
          "url",
          "quote",
          "char_span",
          "content_hash",
          "source_tier",
          "retrieved_at"
        ],
        "additionalProperties": false,
        "properties": {
          "passage_id": {
            "type": "string",
            "pattern": "^PSG-[0-9]{2}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 40,
            "maxLength": 2000
          },
          "char_span": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "kind": {
            "type": "string"
          },
          "licensing": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "quarantined": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cost": {
      "type": "object"
    }
  }
}
