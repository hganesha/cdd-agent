{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.example/schemas/webis/passage.schema.json",
  "title": "Passage",
  "description": "A quotation from a retrieved document. The span is exclusive-end and must satisfy body[char_span[0]:char_span[1]] == quote, byte for byte, before redaction.",
  "type": "object",
  "required": ["passage_id", "url", "quote", "char_span", "content_hash", "source_tier", "retrieved_at"],
  "additionalProperties": false,
  "properties": {
    "passage_id": {"type": "string", "pattern": "^PSG-[0-9]{2}$"},
    "url": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "quote": {"type": "string", "minLength": 40, "maxLength": 2000},
    "char_span": {"type": "array", "items": {"type": "integer", "minimum": 0},
                  "minItems": 2, "maxItems": 2},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "published": {"type": ["string", "null"]},
    "source_tier": {"type": "integer", "minimum": 1, "maximum": 5},
    "kind": {"type": "string"},
    "licensing": {"type": "string"},
    "retrieved_at": {"type": "string", "format": "date-time"}
  }
}
