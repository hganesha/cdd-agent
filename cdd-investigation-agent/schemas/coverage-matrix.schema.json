{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas-cdd.internal/1.0.0/coverage-matrix.schema.json",
  "title": "CoverageMatrix",
  "type": "object",
  "required": [
    "case_id",
    "policy_version",
    "elements",
    "summary"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rde_id",
          "name",
          "status"
        ],
        "properties": {
          "rde_id": {
            "type": "string",
            "pattern": "^RDE-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "required_for": {
            "type": "array",
            "items": {
              "enum": [
                "SDD",
                "CDD",
                "EDD"
              ]
            }
          },
          "status": {
            "enum": [
              "SATISFIED",
              "PARTIAL",
              "MISSING",
              "CONTRADICTED",
              "ILLEGIBLE",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ]
          },
          "gap_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "satisfied",
        "coverage_pct",
        "blocks_decision"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "satisfied": {
          "type": "integer"
        },
        "partial": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        },
        "blocks_decision": {
          "type": "integer"
        },
        "coverage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
