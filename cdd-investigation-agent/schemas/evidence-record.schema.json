{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas-cdd.internal/1.0.0/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "required": [
    "evidence_id",
    "case_id",
    "run_id",
    "record_type",
    "seq",
    "created_at",
    "created_by",
    "basis",
    "confidence",
    "prev_hash",
    "record_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[0-9]+-[0-9]{6}(-c[0-9]+)?$"
    },
    "case_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "record_type": {
      "enum": [
        "REGISTRATION",
        "OBSERVATION",
        "EXTRACTION",
        "COMPUTATION",
        "EXTERNAL_QUERY",
        "FINDING",
        "STATUS_CHANGE",
        "ARTIFACT",
        "GATE",
        "STATE",
        "CORRECTION",
        "CRITIQUE"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "skill"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "pattern": "^SK-[0-9]{2}$"
        },
        "tool": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "prompt_hash": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object"
    },
    "value": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "string"
        },
        "normalized": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "datatype": {
          "type": "string"
        }
      }
    },
    "verbatim_quote": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "translation": {
      "type": [
        "string",
        "null"
      ]
    },
    "basis": {
      "enum": [
        "document",
        "registry",
        "screening",
        "computation",
        "inference",
        "judgment",
        "human"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "extraction_method": {
      "enum": [
        "native_text",
        "ocr",
        "table",
        "vlm",
        "api",
        "human",
        "computation"
      ]
    },
    "locator": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "doc_sha256": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "char_span": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "table": {
          "type": "object"
        }
      }
    },
    "source_meta": {
      "type": "object"
    },
    "query": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "dataset_version": {
          "type": "string"
        },
        "queried_at": {
          "type": "string",
          "format": "date-time"
        },
        "parameters_hash": {
          "type": "string"
        },
        "response_ref": {
          "type": "string"
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "computation": {
      "type": "object",
      "properties": {
        "calc_id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      }
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cited_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "OCR_ERROR",
        "WRONG_PAGE",
        "WRONG_QUOTE",
        "MIS_ATTRIBUTION",
        "ARITHMETIC_ERROR",
        "MISCLASSIFICATION",
        "SUPERSEDED_SOURCE",
        "HUMAN_OVERRIDE"
      ]
    },
    "quarantined": {
      "type": "boolean",
      "default": false
    },
    "quarantine_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "prev_hash": {
      "type": "string"
    },
    "record_hash": {
      "type": "string"
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_meta": {
      "type": "object"
    },
    "detected_type": {
      "type": "string"
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "finding": {
      "type": "object"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "citation_count": {
          "type": "integer"
        }
      }
    },
    "gate": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "critique": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "EXTRACTION"
          }
        }
      },
      "then": {
        "required": [
          "verbatim_quote",
          "locator"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "EXTERNAL_QUERY"
          }
        }
      },
      "then": {
        "required": [
          "query"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "COMPUTATION"
          }
        }
      },
      "then": {
        "required": [
          "computation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "enum": [
              "inference",
              "judgment"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "subject"
          ],
          "properties": {
            "subject": {
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "pattern": "^verified_"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "basis=inference|judgment must never populate a verified_* field; computed values use basis=computation"
}
