{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticCDDGold",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "segment", "tags", "provenance", "evidence_anchors", "verified_fields", "ownership", "screening", "search_mock", "activity", "risk", "gaps", "required_refusals", "quarantine_doc_ids", "required_gates", "recommendation", "decision_authority", "coverage"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]+$"},
    "segment": {"enum": ["corporate_simple", "corporate_complex", "individual_standard", "individual_pep_media", "high_risk_jurisdiction", "adversarial", "degraded_input"]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "generator_seed", "human_reviewed", "release_gate_eligible"],
      "properties": {"kind": {"const": "SYNTHETIC_ORACLE"}, "generator_seed": {"type": "integer"}, "human_reviewed": {"const": false}, "release_gate_eligible": {"const": false}}
    },
    "evidence_anchors": {"$ref": "#/$defs/anchors"},
    "verified_fields": {"$ref": "#/$defs/anchors"},
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["paths", "beneficial_owners", "unresolved_pct", "control_person"],
      "properties": {
        "paths": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["person", "nodes", "percentages", "effective_pct", "basis"], "properties": {"person": {"type": "string"}, "nodes": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "percentages": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 100}}, "effective_pct": {"type": "number", "minimum": 0, "maximum": 100}, "basis": {"const": "document"}}}},
        "beneficial_owners": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "effective_pct"], "properties": {"name": {"type": "string"}, "effective_pct": {"type": "number", "minimum": 25, "maximum": 100}}}},
        "unresolved_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "control_person": {"type": ["string", "null"]}
      }
    },
    "screening": {
      "type": "object", "additionalProperties": false,
      "required": ["true_pep_subjects", "true_sanctions_subjects", "weak_sanctions_subjects", "unavailable_lists", "expected_query_count"],
      "properties": {"true_pep_subjects": {"$ref": "#/$defs/strings"}, "true_sanctions_subjects": {"$ref": "#/$defs/strings"}, "weak_sanctions_subjects": {"$ref": "#/$defs/strings"}, "unavailable_lists": {"$ref": "#/$defs/strings"}, "expected_query_count": {"type": "integer", "minimum": 1}}
    },
    "search_mock": {
      "type": "object", "additionalProperties": false,
      "required": ["source_urls", "relevant_media_urls", "namesake_exclusion_urls", "quarantine_urls", "refusal_urls", "paywall_gap_urls"],
      "properties": {"source_urls": {"$ref": "#/$defs/strings"}, "relevant_media_urls": {"$ref": "#/$defs/strings"}, "namesake_exclusion_urls": {"$ref": "#/$defs/strings"}, "quarantine_urls": {"$ref": "#/$defs/strings"}, "refusal_urls": {"$ref": "#/$defs/strings"}, "paywall_gap_urls": {"$ref": "#/$defs/strings"}}
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["annual_income_or_revenue_usd", "period_credits_usd", "period_months", "annualised_credits_usd", "annualised_credit_to_income_or_revenue_ratio", "inconsistent"],
      "properties": {"annual_income_or_revenue_usd": {"type": "number", "minimum": 0}, "period_credits_usd": {"type": "number", "minimum": 0}, "period_months": {"type": "integer", "minimum": 1}, "annualised_credits_usd": {"type": "number", "minimum": 0}, "annualised_credit_to_income_or_revenue_ratio": {"type": "number", "minimum": 0}, "inconsistent": {"type": "boolean"}}
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["factor_inputs", "score", "band", "cdd_level", "overrides_applied"],
      "properties": {"factor_inputs": {"type": "object", "additionalProperties": {"type": "boolean"}}, "score": {"type": "number", "minimum": 0, "maximum": 100}, "band": {"enum": ["LOW", "MEDIUM", "HIGH", "VERY_HIGH"]}, "cdd_level": {"enum": ["SDD", "CDD", "EDD"]}, "overrides_applied": {"type": "array", "items": {"type": "object"}}}
    },
    "gaps": {"$ref": "#/$defs/strings"},
    "required_refusals": {"$ref": "#/$defs/strings"},
    "quarantine_doc_ids": {"$ref": "#/$defs/strings"},
    "required_gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["G1", "G2", "G3"]}},
    "recommendation": {"enum": ["PROCEED", "PROCEED_WITH_CONDITIONS", "HOLD_FOR_RFI", "ESCALATE_EDD", "REFER_MLRO"]},
    "decision_authority": {"const": "HUMAN"},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["documents_total", "pages_total", "pages_unreadable"], "properties": {"documents_total": {"type": "integer", "minimum": 1}, "pages_total": {"type": "integer", "minimum": 1}, "pages_unreadable": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "anchors": {"type": "array", "minItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "value", "doc_id", "page", "quote", "char_span"],
      "properties": {"key": {"type": "string"}, "value": {}, "doc_id": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1}, "char_span": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}}
    }}
  }
}
